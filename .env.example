# Copy to .env.local and fill in. Never commit real keys.

# Anthropic (console.anthropic.com > API Keys). Used server-side only.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# MiniMax (platform.minimax.io > Account Management > API Keys)
MINIMAX_API_KEY=
# Optional overrides
MINIMAX_MODEL=MiniMax-H3
MINIMAX_RESOLUTION=768P
MINIMAX_DURATION_SECONDS=6

# Supabase (Project Settings > API). The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
